ntent-none","el_class":""}],"el_inner_class":"","el_class":"py-5"},{"device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"section","id":"ov3dtyb","elements":[{"text":"Bamboe vlonderplanken vs hout","heading_type":"h2","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"heading","id":"siyfcua","font_weight":"700","el_class":"mb-2","margin_top":"","padding_top":"","el_inner_class":""},{"content":"<p>Twijfel je tussen bamboe vlonderplanken, hardhouten vlonderplanken of een composiet vlonder? Hieronder zie je in één oogopslag waarom bamboe op de belangrijkste punten beter scoort.</p>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text","id":"c1ebles","el_inner_class":"","el_class":"mb-8  max-w-prose"},{"content":"<div style=\"overflow-x: auto;\">\n<table style=\"width: 100%; min-width: 900px; border-collapse: separate; border-spacing: 0; font-size: 16px; overflow-x: auto;\">\n<thead>\n<tr>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Eigenschap</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; background: #fff3e6; border-radius: 8px 8px 0 0; border-bottom: 2px solid #003017; color: #003017;\">Gumax<sup>®</sup> Bamboo</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Tropisch hardhout</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Vurenhout / grenen</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Composiet</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Groeisnelheid grondstof</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">4–6 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">25–80 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">20–40 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Grotendeels kunststof</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Levensduur</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">20–25 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15–25 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">8–12 jaar</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15–20 jaar</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Vormvastheid</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Zeer stabiel</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Kan werken bij vocht</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Trekt sneller krom, scheurgevoelig</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Stabiel, maar kan uitzetten bij hitte</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Onderhoud</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Jaarlijks reinigen + oliën</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Regelmatig oliën nodig</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Intensief: behandelen tegen rot en houtworm</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Nauwelijks onderhoud, lastig te repareren</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Certificering</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">FSC®-gecertificeerd</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Wisselend, niet altijd gecertificeerd</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Vaak wel FSC/PEFC</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">N.v.t. (kunststof)</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Verkleuring</th>\n<td style=\"padding: 18px 16px; background: #fff3e6; border-bottom: 1px solid #dddddd;\"><strong>Vertraagd door thermische modificatie.</strong><br>Met jaarlijks oliën is de kleur te herstellen.</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Vergrijst zichtbaar binnen enkele maanden zonder onderhoud</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Verkleurt snel en ongelijkmatig</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Kan verbleken door UV, kleur is niet te herstellen</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017;\" scope=\"row\">Uitstraling</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-radius: 0 0 8px 8px;\">Warme, natuurlijke houtlook</td>\n<td style=\"padding: 18px 16px;\">Natuurlijke houtlook</td>\n<td style=\"padding: 18px 16px;\">Natuurlijke houtlook</td>\n<td style=\"padding: 18px 16px;\">Vaak minder natuurlijke uitstraling</td>\n</tr>\n</tbody>\n</table>\n</div>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text","id":"ax355ul"}],"el_inner_class":"","el_class":"