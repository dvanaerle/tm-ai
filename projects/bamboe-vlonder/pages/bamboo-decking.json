tion":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"section","id":"ov3dtyb","elements":[{"text":"Bamboo decking compared with wood","heading_type":"h2","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"heading","id":"siyfcua","font_weight":"700","el_class":"mb-2","margin_top":"","padding_top":"","el_inner_class":""},{"content":"<p>Choosing between bamboo, hardwood and composite decking? This table shows the key differences at a glance.</p>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text","id":"c1ebles","el_inner_class":"","el_class":"mb-8  max-w-prose"},{"content":"<div style=\"overflow-x: auto;\">\n<table style=\"width: 100%; min-width: 900px; border-collapse: separate; border-spacing: 0; font-size: 16px; overflow-x: auto;\">\n<thead>\n<tr>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Feature</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; background: #fff3e6; border-radius: 8px 8px 0 0; border-bottom: 2px solid #003017; color: #003017;\">Gumax<sup>®</sup> bamboo</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Tropical hardwood</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Spruce / pine</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Composite</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Raw material growth time</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">4–6 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">25–80 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">20–40 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Mostly plastic</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Lifespan</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">20–25 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15–25 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">8–12 years</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15–20 years</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Dimensional stability</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Very stable</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">May move when damp</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Warps faster and is prone to cracking</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Stable, but may expand in heat</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Maintenance</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Clean and oil annually</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Regular oiling required</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Intensive: treat against rot and woodworm</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Low maintenance, difficult to repair</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Certification</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">FSC<sup>®</sup> certified</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Varies; not always certified</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Often FSC/PEFC certified</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">N/A (plastic)</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Discolouration</th>\n<td style=\"padding: 18px 16px; background: #fff3e6; border-bottom: 1px solid #dddddd;\"><strong>Slowed by thermal modification.</strong><br>Annual oiling revives the colour.</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Visibly greys within months without maintenance</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Discolours quickly and unevenly</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">May fade due to UV; the colour cannot be revived</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017;\" scope=\"row\">Appearance</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-radius: 0 0 8px 8px;\">Warm, natural wood look</td>\n<td style=\"padding: 18px 16px;\">Natural wood look</td>\n<td style=\"padding: 18px 16px;\">Natural wood look</td>\n<td style=\"padding: 18px 16px;\">Often looks less natural</td>\n</tr>\n</tbody>\n</table>\n</div>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text","id":"ax355ul"}],"el_inner_class":"","el_class":"py-5","el_id":""},{"device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top