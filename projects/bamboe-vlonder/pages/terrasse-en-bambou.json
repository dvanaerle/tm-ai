:""}],"el_inner_class":"","el_class":"py-5"},{"device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"section","id":"ov3dtyb","elements":[{"text":"Terrasse en bambou ou terrasse en bois","heading_type":"h2","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"heading","id":"siyfcua","font_weight":"700","el_class":"mb-2","margin_top":"","padding_top":"","el_inner_class":""},{"content":"<p>Vous hésitez entre le bambou, le bois dur et le composite ? Ce tableau compare les différences essentielles en un coup d’œil.</p>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text","id":"c1ebles","el_inner_class":"","el_class":"mb-8  max-w-prose"},{"content":"<div style=\"overflow-x: auto;\">\n<table style=\"width: 100%; min-width: 900px; border-collapse: separate; border-spacing: 0; font-size: 16px; overflow-x: auto;\">\n<thead>\n<tr>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Caractéristique</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; background: #fff3e6; border-radius: 8px 8px 0 0; border-bottom: 2px solid #003017; color: #003017;\">Bambou Gumax<sup>®</sup></th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Bois dur tropical</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Épicéa / pin</th>\n<th style=\"width: 20%; padding: 16px; text-align: left; border-bottom: 2px solid #003017; color: #003017;\">Composite</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Temps de croissance de la matière première</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">4 à 6 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">25 à 80 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">20 à 40 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Principalement en plastique</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Durée de vie</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">20 à 25 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15 à 25 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">8 à 12 ans</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">15 à 20 ans</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Stabilité dimensionnelle</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Très stable</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Peut bouger sous l'effet de l'humidité</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Se déforme plus vite et se fissure facilement</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Stable, mais peut se dilater sous la chaleur</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Entretien</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Nettoyage et huilage annuels</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Huilage régulier nécessaire</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Intensif : traitement contre la pourriture et les insectes xylophages</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Peu d’entretien, difficile à réparer</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Certification</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-bottom: 1px solid #dddddd;\">Certifié FSC<sup>®</sup></td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Variable, pas toujours certifié</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Souvent certifié FSC/PEFC</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Sans objet (plastique)</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017; border-bottom: 1px solid #dddddd;\" scope=\"row\">Décoloration</th>\n<td style=\"padding: 18px 16px; background: #fff3e6; border-bottom: 1px solid #dddddd;\"><strong>Ralentissement grâce au traitement thermique.</strong><br>Un huilage annuel ravive la couleur.</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Grise visiblement en quelques mois sans entretien</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Se décolore vite et de façon irrégulière</td>\n<td style=\"padding: 18px 16px; border-bottom: 1px solid #dddddd;\">Peut pâlir sous l’effet des UV ; la couleur ne se ravive pas</td>\n</tr>\n<tr>\n<th style=\"padding: 18px 16px; text-align: left; font-weight: 600; color: #003017;\" scope=\"row\">Aspect</th>\n<td style=\"padding: 18px 16px; font-weight: 600; background: #fff3e6; border-radius: 0 0 8px 8px;\">Aspect bois chaleureux et naturel</td>\n<td style=\"padding: 18px 16px;\">Aspect bois naturel</td>\n<td style=\"padding: 18px 16px;\">Aspect bois naturel</td>\n<td style=\"padding: 18px 16px;\">Aspect souvent moins naturel</td>\n</tr>\n</tbody>\n</table>\n</div>","device_type":"all","background_type":"image","background_style":"auto","background_position":"center-top","parallax_speed":0.5,"mouse_parallax_size":30,"mouse_parallax_speed":10000,"lg_background_type":"image","lg_background_style":"auto","lg_background_position":"center-top","md_background_type":"image","md_background_style":"auto","md_background_position":"center-top","sm_background_type":"image","sm_background_style":"auto","sm_background_position":"center-top","xs_background_type":"image","xs_background_style":"auto","xs_background_position":"center-top","type":"text"